<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Document</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        h2 {
            color: #333;
            margin-top: 30px;
        }
        .result {
            background-color: #f0f0f0;
            padding: 10px;
            border-left: 4px solid #4CAF50;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <h1>Лабораторна робота</h1>

    <h2>Завдання 1</h2>
    <div id="task1-res1" class="result"></div>
    <div id="task1-res2" class="result"></div>

    <h2>Завдання 2</h2>
    <p><i>(Результати також виведено у консоль)</i></p>
    <div id="task2-res1" class="result"></div>
    <div id="task2-res2" class="result"></div>

    <h2>Завдання 3)</h2>
    <div id="task3-res" class="result">Чекаємо</div>

    <h2>Завдання 4</h2>
    <div id="task4-res1" class="result"></div>
    <div id="task4-res2" class="result"></div>


    <script>
        function onSuccess(result) {
            return "Результат: " + result;
        }

        function onError(error) {
            return "Помилка: " + error;
        }

        function calculate(a, b, onSuccess, onError) {
            if (b === 0) {
                return onError("На нуль не можна ділити");
            } else {
                var res = a / b;
                return onSuccess(res);
            }
        }

        document.getElementById('task1-res1').innerText = calculate(10, 2, onSuccess, onError);
        document.getElementById('task1-res2').innerText = calculate(10, 0, onSuccess, onError);

        function logElement(element) {
            console.log("Елемент:", element);
        }

        function squareElement(element) {
            return element * element;
        }

        function processArray(array, callback) {
            var newArray = [];
            for (var i = 0; i < array.length; i++) {
                var result = callback(array[i]);
                if (result !== undefined) {
                    newArray.push(result);
                }
            }
            if (newArray.length > 0) {
                return newArray;
            }
        }

        var arr = [1, 2, 3, 4, 5];
        
        console.log("Завдання2");
        processArray(arr, logElement);

        var squaredArr = processArray(arr, squareElement);
        
        document.getElementById('task2-res1').innerText = "logElement: елементи виведено)";
        document.getElementById('task2-res2').innerText = "squareElement: [" + squaredArr.join(", ") + "]";
        function createOrder(orderId) {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Створено" + orderId);
                }, 1000);
            });
        }

        function processOrder(orderId) {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Оброблено" + orderId);
                }, 2000);
            });
        }

        function deliverOrder(orderId) {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Доставлено" + orderId);
                }, 3000);
            });
        }
        var task3Box = document.getElementById('task3-res');
        var myOrderId = 101;

        createOrder(myOrderId)
            .then(function(msg1) {
                task3Box.innerHTML = msg1 + "<br>";
                return processOrder(myOrderId);
            })
            .then(function(msg2) {
                task3Box.innerHTML += msg2 + "<br>";
                return deliverOrder(myOrderId);
            })
            .then(function(msg3) {
                task3Box.innerHTML += msg3;
            });

        function checkEvenNumber(number) {
            return new Promise(function(resolve, reject) {
                setTimeout(function() {
                    if (number % 2 === 0) {
                        resolve("Парне: " + number);
                    } else {
                        reject("Непарне: " + number);
                    }
                }, 1000);
            });
        }

        checkEvenNumber(4)
            .then(function(res) {
                document.getElementById('task4-res1').innerText = res;
            })
            .catch(function(err) {
                document.getElementById('task4-res1').innerText = err;
            });

        checkEvenNumber(5)
            .then(function(res) {
                document.getElementById('task4-res2').innerText = res;
            })
            .catch(function(err) {
                document.getElementById('task4-res2').innerText = err;
            });

    </script>
</body>
</html>
