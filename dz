<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Document</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        h2 {
            color: #333;
            margin-top: 30px;
        }
        .result {
            background-color: #f0f0f0;
            padding: 10px;
            border-left: 4px solid #4CAF50;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <h2>1</h2>
    <div class="result" id="task1-1"></div>
    <div class="result" id="task1-2"></div>

    <h2>2</h2>
    <div class="result" id="task2-1"></div>
    <div class="result" id="task2-2"></div>

    <h2>3</h2>
    <div class="result" id="task3"></div>

    <h2>4</h2>
    <div class="result" id="task4-1"></div>
    <div class="result" id="task4-2"></div>

    <script>
        function doubleElement(element) {
            return element * 2;
        }

        function reverseElement(element) {
            return String(element).split('').reverse().join('');
        }

        function processArray(array, callback) {
            let result = [];
            for (let i = 0; i < array.length; i++) {
                result.push(callback(array[i]));
            }
            return result;
        }

        let res1_1 = processArray([1, 2, 3, 4, 5], doubleElement);
        let res1_2 = processArray(["hello", "world"], reverseElement);

        document.getElementById("task1-1").innerText = "Подвоєння: " + JSON.stringify(res1_1);
        document.getElementById("task1-2").innerText = "Перевертання: " + JSON.stringify(res1_2);

        function isEven(number) {
            return number % 2 === 0;
        }

        function isShortWord(word) {
            return word.length <= 4;
        }

        function filterArray(array, callback) {
            let result = [];
            for (let i = 0; i < array.length; i++) {
                if (callback(array[i]) === true) {
                    result.push(array[i]);
                }
            }
            return result;
        }

        let res2_1 = filterArray([1, 2, 3, 4, 5], isEven);
        let res2_2 = filterArray(["cat", "elephant", "dog", "bird"], isShortWord);

        document.getElementById("task2-1").innerText = "Парні числа: " + JSON.stringify(res2_1);
        document.getElementById("task2-2").innerText = "Слова: " + JSON.stringify(res2_2);


        function washDishes() {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Вимито");
                }, 2000);
            });
        }

        function cleanRoom() {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Прибрано");
                }, 4000);
            });
        }

        function makeDinner() {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Вечеря приготовлена");
                }, 7000);
            });
        }

        let task3Div = document.getElementById("task3");
        task3Div.innerText = "виконання задач";

        washDishes()
            .then(function(res1) {
                task3Div.innerHTML = res1 + "<br>";
                return cleanRoom();
            })
            .then(function(res2) {
                task3Div.innerHTML += res2 + "<br>";
                return makeDinner();
            })
            .then(function(res3) {
                task3Div.innerHTML += res3;
            });


        function sortArray(array) {
            return new Promise(function(resolve, reject) {
                if (array.length === 0) {
                    reject("Масив порожній");
                } else {
                    setTimeout(function() {
                        let sorted = array.slice().sort(function(a, b) {
                            return a - b;
                        });
                        resolve(sorted);
                    }, 2000);
                }
            });
        }

        sortArray([5, 2, 8, 1, 4])
            .then(function(res) {
                document.getElementById("task4-1").innerText = "Результат: " + JSON.stringify(res);
            })
            .catch(function(err) {
                document.getElementById("task4-1").innerText = "Помилка: " + err;
            });

        sortArray([])
            .then(function(res) {
                document.getElementById("task4-2").innerText = "Результатя: " + JSON.stringify(res);
            })
            .catch(function(err) {
                document.getElementById("task4-2").innerText = "Помилка масиву: " + err;
            });
    </script>
</body>
</html>
